<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃卡片。渐变填充（上亮下略暗）模拟光从上方打过来，
     1dp 亮描边是玻璃边缘的反光。圆角给到 20dp：小圆角配半透明
     会显得像没做完的方块，大圆角才有"一块玻璃"的实体感。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <gradient
        android:angle="270"
        android:startColor="@color/glass_fill_top"
        android:endColor="@color/glass_fill_bottom"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
