<?xml version="1.0" encoding="utf-8"?>
<!-- 多选筹码（端口 / 地区）的背景。
     用 state_selected 而不是 state_checked：这些是 TextView，
     不是 Checkable，只能靠 setSelected() 驱动状态。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/result_background" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/result_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_input" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_hairline" />
        </shape>
    </item>
</selector>
