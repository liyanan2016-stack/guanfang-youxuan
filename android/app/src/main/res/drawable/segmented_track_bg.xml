<?xml version="1.0" encoding="utf-8"?>
<!-- IPv4/IPv6 分段控件的轨道。改成药丸形，和 chip(16dp) 的圆度呼应，
     填充用玻璃 —— 它嵌在玻璃卡片里，实心底色会显得像贴上去的补丁。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_input" />
    <stroke android:width="1dp" android:color="@color/glass_hairline" />
    <corners android:radius="99dp" />
</shape>
